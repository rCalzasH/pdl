// Test line comment: keywords and identifiers
let x = 10;
float pi = 3.14;
int limit = 32767;
string message = "Hello, PdL-JS";

/* Test block comment 
   spanning multiple lines */
function checkValue() {
    if (x < limit) {
        echo message;
    }
    x -= 1;
}

